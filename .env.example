# =============================================================================
# Luna Bot — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# === Chat Settings ===
MIN_MESSAGES=10
MAX_MESSAGES=50
CONTEXT_WINDOW=300
IMAGE_GENERATION_CONTEXT_WINDOW=50
BOT_USER_ID=your_bot_user_id_here
USE_STRUCTURED_MESSAGE_FORMAT=true

# === Time Settings ===
DAILY_TAKE_TIME=20
TIME_ZONE=Asia/Yekaterinburg

# === Gemini Model Settings ===
GEMINI_MODEL_NAME=gemini-2.0-flash
GEMINI_TEMPERATURE_NORMAL=1.0
GEMINI_TEMPERATURE_SERIOUS=0.9
AUDIO_TRANSCRIPTION_MODEL=gemini-2.0-flash
AUDIO_TRANSCRIPTION_TEMPERATURE=0.3
IMAGE_GENERATION_MODEL=gemini-2.5-flash-image-preview
IMAGE_GENERATION_TEMPERATURE=0.7
GEMINI_KEY_ROTATION_TIME_HOURS=1
GEMINI_EMBEDDING_MODEL_NAME=embedding-001

# === LLM Provider ===
LLM_PROVIDER=gemini
DEEPSEEK_MODEL_NAME=deepseek-chat
OPENROUTER_MODEL_NAME=deepseek/deepseek-chat-v3.1:free

# === LLM Fallback ===
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_CRITICAL_TYPES=free_will,direct,direct_serious,voice
LLM_FALLBACK_PROVIDER_ORDER=deepseek,openrouter

# === Gemini Safety ===
GEMINI_BYPASS_SAFETY_FILTERS=true
GEMINI_OBFUSCATE_PROMPTS=false

# === API Keys (set these!) ===
# TELEGRAM_TOKEN=your_telegram_bot_token_here
# GEMINI_API_KEY=your_gemini_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# === Storage ===
STORAGE_TYPE=postgres
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=your_password_here
POSTGRESQL_DBNAME=luna_bot
# MongoDB (optional, if STORAGE_TYPE=mongo)
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DBNAME=luna_bot
# MONGODB_MESSAGES_COLLECTION=chat_messages
# MONGODB_USER_PROFILES_COLLECTION=user_profiles

# === Embedding & Migration ===
EMBEDDING_REQUESTS_PER_MINUTE=240
EMBEDDING_REQUESTS_PER_DAY=24000
EMBEDDING_BATCH_SIZE=100
EMBEDDING_REQUEST_DELAY=0.3s
EMBEDDING_BATCH_DELAY=60s
EMBEDDING_ADAPTIVE_THROTTLING=true
EMBEDDING_SAFETY_MARGIN=0.8
EMBEDDING_MAX_RETRIES=3
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_DIR=./cache/embeddings
MIGRATION_RESUME_ENABLED=true
MIGRATION_STATE_FILE=./migration_state.json

# === MongoDB Cleanup ===
MONGO_CLEANUP_ENABLED=false
MONGO_CLEANUP_SIZE_LIMIT_MB=450
MONGO_CLEANUP_INTERVAL_MINUTES=60
MONGO_CLEANUP_CHUNK_DURATION_HOURS=24

# === Long-Term Memory ===
LONG_TERM_MEMORY_ENABLED=false
MONGO_VECTOR_INDEX_NAME=vector_index
LONG_TERM_MEMORY_FETCH_K=5
BACKFILL_BATCH_SIZE=100
BACKFILL_BATCH_DELAY_SECONDS=1

# === Admin ===
ADMIN_USERNAMES=your_telegram_username_here

# === Debug ===
DEBUG=false

# === Summary Settings ===
SUMMARY_INTERVAL_HOURS=0
SUMMARY_MAX_PARTS=5
WEEKLY_SUMMARY_ENABLED=false
WEEKLY_SUMMARY_DAY=0
WEEKLY_SUMMARY_HOUR=18
WEEKLY_SUMMARY_MINUTE=0
WEEKLY_SUMMARY_MAX_PARTS=5
WEEKLY_SUMMARY_SEARCH_METHOD=both
SUMMARY_FLAGS_ENABLED=true
SUMMARY_KEYWORDS_ENABLED=true

# === Rate Limit ===
RATE_LIMIT_STATIC_TEXT=Превышен лимит запросов. Попробуй позже.

# === Settings Input Prompts (UI text, not AI prompts) ===
PROMPT_ENTER_MIN_MESSAGES="Минимальное количество сообщений для ответа:"
PROMPT_ENTER_MAX_MESSAGES="Максимальное количество сообщений для ответа:"
PROMPT_ENTER_DAILY_TIME="В какой час кидать ежедневную тему (0-23):"
PROMPT_ENTER_SUMMARY_INTERVAL="Интервал саммари в часах (0 - выкл):"

# === Srach (Conflict) Detection ===
SRACH_KEYWORDS=спор,конфликт,оскорбление
SRACH_ANALYSIS_ENABLED=true

# === Direct Reply Limits ===
DIRECT_REPLY_LIMIT_ENABLED_DEFAULT=false
DIRECT_REPLY_LIMIT_COUNT_DEFAULT=3
DIRECT_REPLY_LIMIT_DURATION_MINUTES_DEFAULT=60
PROMPT_ENTER_DIRECT_LIMIT_COUNT="Максимальное количество прямых обращений за период:"
PROMPT_ENTER_DIRECT_LIMIT_DURATION="Длительность периода лимита (в минутах):"

# === Photo Analysis ===
PHOTO_ANALYSIS_ENABLED=false

# === Auto Bio ===
AUTO_BIO_ENABLED=false
AUTO_BIO_INTERVAL_HOURS=24
AUTO_BIO_MESSAGES_LOOKBACK_DAYS=30
AUTO_BIO_MIN_MESSAGES_FOR_ANALYSIS=10
AUTO_BIO_MAX_MESSAGES_FOR_ANALYSIS=1000

# === Donate ===
DONATE_TIME_HOURS=24
PAYMENT_REMINDER_INTERVAL_HOURS=6

# === Error Messages ===
ERROR_MESSAGE_AUTO_DELETE_SECONDS=5

# === Free Will ===
FREE_WILL_ENABLED=false
FREE_WILL_MIN_INTERVAL_MINUTES=15
FREE_WILL_MAX_INTERVAL_MINUTES=60
FREE_WILL_CONTEXT_WINDOW=50
FREE_WILL_MOOD_UPDATE_PROBABILITY=0.1
FREE_WILL_MAX_DECISIONS_PER_HOUR=10
FREE_WILL_VOICE_PROBABILITY=0.3
FREE_WILL_SILENCE_MIN_MINUTES=3.0
FREE_WILL_SILENCE_MAX_MINUTES=20.0
INTERVAL_MESSAGES_ENABLED=true

# === Free Will Reactions ===
FREE_WILL_REACTIONS_ENABLED=true
FREE_WILL_REACTIONS_PROBABILITY=0.2
FREE_WILL_REACTIONS_COOLDOWN_MINUTES=5
FREE_WILL_REACTIONS_MAX_PER_HOUR=15

# === Free Will Direct Response ===
BOT_NAMES=Катя,катя,Luna,luna

# === Free Will Image Generation ===
FREE_WILL_IMAGE_GENERATION_INTERVAL_HOURS=6
FREE_WILL_IMAGE_GENERATION_MAX_DECISIONS_PER_INTERVAL=3
FREE_WILL_IMAGE_GENERATION_MIN_DECISION_INTERVAL_MINUTES=30
FREE_WILL_IMAGE_GENERATION_INDEPENDENT_LIMITS=true

# === Moderation ===
MOD_ENABLED=false
MOD_INTERVAL=1
MOD_MUTE_TIME_MIN=5
MOD_KICK_TIME_MIN=1
MOD_BAN_TIME_MIN=60
MOD_PURGE_DELAY_DURATION=0s
MOD_PURGE_WINDOW_DURATION=1h
MOD_CHECK_ADMIN_RIGHTS=true
MOD_DEFAULT_NOTIFY=false
MOD_RULES=[]

# === Personality Memory ===
PERSONALITY_UPDATE_INTERVAL_HOURS=1
PERSONALITY_MESSAGES_LOOKBACK=50
MAX_NAME_MENTIONS=10
MAX_RECENT_TOPICS=10
MAX_SELF_PERCEPTIONS=5
MAX_DISCUSSION_CONTEXTS=3

# === Reactions ===
REACTIONS_ENABLED=true
CLOWN_RESPONSE_PROBABILITY=40
CLOWN_COOLDOWN_SECONDS=30
MAX_CLOWN_RESPONSES_PER_HOUR=10

# === Web Search ===
WEB_SEARCH_ENABLED=true
# GOOGLE_SEARCH_API_KEY=your_google_api_key_here
# GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_CACHE_TTL=5m
WEB_SEARCH_CACHE_MAX_SIZE=100

# === User Disambiguation ===
DISAMBIGUATION_ENABLED=true

# === Voice Messages ===
VOICE_MESSAGES_ENABLED=true
MIN_VOICE_MESSAGES=50
MAX_VOICE_MESSAGES=100

# === ElevenLabs TTS ===
ELEVENLABS_VOICE_ID=Obuyk6KKzg9olSLPaCbl
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_PLAN=starter
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.8
ELEVENLABS_STYLE=0.0
ELEVENLABS_USE_SPEAKER_BOOST=true
ELEVENLABS_SPEED=1.0
ELEVENLABS_RANDOM_VOICE=false

# === Anti-Repetition ===
ANTI_REPETITION_ENABLED=true
ANTI_REPETITION_MAX_RESPONSES_PER_CHAT=20
ANTI_REPETITION_SIMILARITY_THRESHOLD=0.75
ANTI_REPETITION_TIME_WINDOW_HOURS=24
ANTI_REPETITION_CLEANUP_INTERVAL_HOURS=1
ANTI_REPETITION_REWORK_ENABLED=true
ANTI_REPETITION_MAX_REWORK_ATTEMPTS=2
ANTI_REPETITION_REWORK_TEMPERATURE=0.8
ANTI_REPETITION_LOCAL_REWORK_ENABLED=true
ANTI_REPETITION_LOCAL_REWORK_MAX_LENGTH=50

# === Message Post-Processor ===
MESSAGE_POST_PROCESSOR_ENABLED=true
MESSAGE_POST_PROCESSOR_RANDOMIZATION_ENABLED=true
MESSAGE_POST_PROCESSOR_SINGLE_WORD_PROBABILITY=0.20
MESSAGE_POST_PROCESSOR_SHORT_SENTENCES_PROBABILITY=0.35
MESSAGE_POST_PROCESSOR_LONG_MESSAGES_PROBABILITY=0.25
MESSAGE_POST_PROCESSOR_MIN_LENGTH=10
MESSAGE_POST_PROCESSOR_MAX_LENGTH=2000
MESSAGE_POST_PROCESSOR_LONG_MESSAGE_THRESHOLD=100
MESSAGE_POST_PROCESSOR_FORCE_LONG_PROCESSING_THRESHOLD=200
MESSAGE_POST_PROCESSOR_TIMEOUT_SECONDS=15
MESSAGE_POST_PROCESSOR_TEMPERATURE=0.9
MESSAGE_POST_PROCESSOR_CACHE_ENABLED=true
MESSAGE_POST_PROCESSOR_CACHE_TTL_MINUTES=30
MESSAGE_POST_PROCESSOR_EXCLUDE_TYPES=system,error,admin
MESSAGE_POST_PROCESSOR_WEEKLY_SUMMARY_EXCLUDE=true
MESSAGE_POST_PROCESSOR_DEBUG_LOGGING=false
MESSAGE_POST_PROCESSOR_LOG_ORIGINAL_MESSAGES=false
MESSAGE_POST_PROCESSOR_REPLACEMENT_CACHE_ENABLED=true
MESSAGE_POST_PROCESSOR_REPLACEMENT_CACHE_TTL_MINUTES=10

# === Causal Learning ===
CAUSAL_LEARNING_ENABLED=false
CAUSAL_ANALYSIS_INTERVAL_HOURS=4
CAUSAL_MIN_CONFIDENCE=0.3
CAUSAL_TEMPORAL_WINDOW_MINUTES=60
CAUSAL_MAX_ENTRIES_PER_CHAT=500
CAUSAL_ANALYSIS_LOOKBACK_MESSAGES=100

# === Emotional System ===
EMOTIONAL_LEARNING_ENABLED=true
EMOTIONAL_ANALYSIS_INTERVAL_HOURS=2
EMOTIONAL_ANALYSIS_LOOKBACK_MESSAGES=100
EMOTIONAL_MEMORY_RETENTION_DAYS=30

# === Cognitive Architecture ===
INTERNAL_MONOLOGUE_ENABLED=false
SELF_REFLECTION_ENABLED=false

# === Social Architecture ===
RELATIONSHIP_TRACKING_ENABLED=false

# === Association Cloud ===
ASSOCIATION_CLOUD_ENABLED=false
ASSOCIATION_CLOUD_MAX_NODES=5000
ASSOCIATION_CLOUD_MAX_EDGES=50000
ASSOCIATION_CLOUD_DECAY_DAYS=30

# === Belief System ===
BELIEF_LEARNING_ENABLED=false
BELIEF_ANALYSIS_INTERVAL_HOURS=6
BELIEF_ANALYSIS_LOOKBACK_MESSAGES=150
