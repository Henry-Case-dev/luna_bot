# Luna Bot — пример секретов
# Скопируй в .env и заполни своими значениями:
#   cp .env.example .env
# Основной конфиг: configs/luna_bot.yaml

# Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# LLM API-ключи
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY_RESERVE=your_reserve_key

# База данных (PostgreSQL)
POSTGRESQL_HOST=localhost
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=your_password_here
POSTGRESQL_DBNAME=luna_bot
POSTGRESQL_SSLMODE=disable

# Grafana / Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_password_here
GF_SERVER_ROOT_URL=http://localhost:3000
COMPOSE_PROJECT_NAME=luna_bot

# Раскомментируйте при необходимости:
# DEEPSEEK_API_KEY=your_deepseek_key
# OPENROUTER_API_KEY=your_openrouter_key
# OPENAI_API_KEY=your_openai_key
# ELEVENLABS_API_KEY=your_key
# GOOGLE_SEARCH_API_KEY=your_key
# GOOGLE_SEARCH_ENGINE_ID=your_id
