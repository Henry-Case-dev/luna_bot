# Luna Bot — пример секретов
# Скопируй в .env и заполни своими значениями:
#   cp .env.example .env
# Основной конфиг: configs/luna_bot.yaml

# Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# LLM API-ключи (выбери один)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY_RESERVE=your_reserve_key
# DEEPSEEK_API_KEY=your_deepseek_key
# OPENROUTER_API_KEY=your_openrouter_key

# База данных
POSTGRESQL_PASSWORD=your_password_here

# TTS (опционально)
# ELEVENLABS_API_KEY=your_key

# Веб-поиск (опционально)
# GOOGLE_SEARCH_API_KEY=your_key
# GOOGLE_SEARCH_ENGINE_ID=your_id

